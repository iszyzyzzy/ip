{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "机器人遥操作终端",
  "version": "0.1.0",
  "identifier": "com.robot.teleop.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "机器人遥操作监控终端",
        "width": 1440,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 700,
        "backgroundColor": "#030a18"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
