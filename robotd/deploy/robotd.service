[Unit]
Description=Robot control and configuration daemon
After=network.target

[Service]
Type=simple
User=robot
SupplementaryGroups=dialout
WorkingDirectory=/opt/robot
ExecStart=/opt/robot/.venv/bin/robotd --db /var/lib/robotd/robotd.sqlite
StateDirectory=robotd
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
