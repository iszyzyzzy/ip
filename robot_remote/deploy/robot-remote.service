[Unit]
Description=robotd 网页遥控 HTTP/WebSocket 网关
After=network.target

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=/opt/robot
EnvironmentFile=-/etc/robot-remote.env
ExecStart=/opt/robot/.venv/bin/robot-remote --robotd 127.0.0.1:50051 --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
